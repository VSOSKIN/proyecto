<form action="/admin/promociones/add" method="POST" enctype="multipart/form-data">
  <input type="text" name="titulo" placeholder="Título" required>
  <input type="text" name="subtitulo" placeholder="Subtítulo" required>
  <textarea name="cuerpo" placeholder="Cuerpo" required></textarea>
  <input type="file" name="imagen" accept="image/*" required>
  <button type="submit">Subir promoción</button>
</form>
