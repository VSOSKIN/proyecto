<h2 class="text-center mb-4">Promociones</h2>

<table class="table table-dark table-striped">
  <thead>
    <tr>
      <th>ID</th>
      <th>Título</th>
      <th>Subtítulo</th>
      <th>Cuerpo</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    {{#each promociones}}
      <tr>
        <td>{{this.id}}</td>
        <td>{{this.titulo}}</td>
        <td>{{this.subtitulo}}</td>
        <td>{{this.cuerpo}}</td>
        <td>
          <a href="/admin/promociones/editar/{{this.id}}" class="btn btn-sm btn-warning me-1">
            <i class="fa fa-edit"></i> Editar
          </a>

          <form action="/admin/promociones/borrar/{{this.id}}" method="POST" style="display:inline-block;">
            <button type="submit" class="btn btn-sm btn-danger">
              <i class="fa fa-trash"></i> Borrar
            </button>
          </form>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>

<!-- Botón de Cerrar sesión -->
<div class="text-center mt-4">
  <form action="/admin/logout" method="POST">
    <button type="submit" class="btn btn-secondary">
      <i class="fa fa-sign-out-alt"></i> Cerrar sesión
    </button>
  </form>
</div>
